{
  "info": {
    "name": "GeoAssist - Assignment 6",
    "description": "Runnable ordered backend demonstration. Local synthetic accounts only. Run once per minute to respect login rate limits; registration is limited to 5/hour/IP. Requests create a fresh user, create and soft-delete one demonstration place. Cookies are managed by Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "new_user_email",
      "value": ""
    },
    {
      "key": "new_user_password",
      "value": "Postman-demo-2026!"
    },
    {
      "key": "place_id",
      "value": ""
    },
    {
      "key": "place_version",
      "value": "1"
    },
    {
      "key": "view_event_key",
      "value": ""
    },
    {
      "key": "select_event_key",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if ([\"POST\", \"PUT\", \"PATCH\", \"DELETE\"].includes(pm.request.method)) {",
          "  pm.request.headers.upsert({key: \"Origin\", value: pm.variables.get(\"origin\")});",
          "  pm.request.headers.upsert({key: \"X-GeoAssist-CSRF\", value: \"1\"});",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"No credential fields in response\", function () { pm.expect(pm.response.text()).not.to.include(\"password_hash\"); pm.expect(pm.response.text()).not.to.include(\"token_hash\"); });"
        ]
      }
    }
  ],
