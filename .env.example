APP_ORIGIN=http://localhost:8080
MONGO_DATABASE=geoassist
AUTO_SEED=true
# Site + API in Docker: open http://localhost:8080 (not 127.0.0.1).
# For Vite development, set APP_ORIGIN=http://localhost:5173 and recreate api.
# WEB_DIR is /app/web in Docker; optional absolute path for a local Go process.
# For local Go execution, environment variables (not this file) are read:
# MONGO_URI=mongodb://localhost:27018/?replicaSet=rs0&directConnection=true
